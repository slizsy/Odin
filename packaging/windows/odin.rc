      VALUE "ProductName", "Odin"
      VALUE "ProductVersion", "0.1.1"
      VALUE "OriginalFilename", "odin.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
